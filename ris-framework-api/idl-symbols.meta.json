TypeSymbol":{"Name":"Color","Namespace":"System.Drawing","IsArray":false,"ElementType":null},"DocComment":{"Summary":"The clear color of the renderer.\n    Framebuffer will be cleared with this color at the beginning of the frame.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false}],"MethodSymbols":[],"EventSymbols":[],"Id":"8996F98A387BA1D1","Name":"IRenderer","Type":"IdlInterfaceSymbol","DocComment":{"Summary":"The interface for a renderer.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"Ris.Framework.Rendering","Visibility":0}],"Classes":[],"Enums":[{"FieldSymbols":[{"Name":"None","TypeName":null,"Value":"0","DocComment":{"Summary":"No buffer usage is defined.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"VERTEX","TypeName":null,"Value":"1","DocComment":{"Summary":"Allow a buffer to be the vertex buffer in a draw operation.\n    \n    Corresponding binding in WGPU is WGPU_VERTEX.\n    Corresponding usage in OpenGL/WebGL is GL_ELEMENT_ARRAY_BUFFER.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Index","TypeName":null,"Value":"2","DocComment":{"Summary":"The buffer is used as an index buffer in a draw operation.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Uniform","TypeName":null,"Value":"3","DocComment":{"Summary":"Allow a buffer to be the uniform buffer in a draw operation.\n    \n    Corresponding binding in WGPU is WGPU_UNIFORM.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Storage","TypeName":null,"Value":"4","DocComment":{"Summary":"Allow a buffer to be the storage buffer in a draw operation.\n    \n    In WGPU this will resolve to WGPU_STORAGE.\n    \n    In OpenGL this will resolve to GL_SHADER_STORAGE_BUFFER.\n    \n    In D3D11 this will resolve to usage D3D11_USAGE_DEFAULT.\n    \n    In D3D11 this will resolve to bind flags D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS.\n    \n    In D3D11 this will resolve to misc flags D3D11_RESOURCE_MISC_BUFFER_STRUCTURED.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"MapRead","TypeName":null,"Value":"5","DocComment":{"Summary":"Buffer is allowed to be read from.\n    \n    Common use case is copying data from the buffer to the CPU memory.\n    \n    Corresponding binding in WGPU is WGPU_MAP_READ.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"CopyDst","TypeName":null,"Value":"6","DocComment":{"Summary":"Buffer is used as destination for copying.\n    \n    Common use case is writing data to a buffer.\n    \n    Corresponding binding in WGPU is WGPU_COPY_DST.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Vertex_CopyDst","TypeName":null,"Value":"7","DocComment":{"Summary":"Combination of  and .\n    \n    For example can be used when needing to create a vertex buffer which is to be written into\n    via queue commands.","Remarks":["Corresponding usage in OpenGL/WebGL is GL_ELEMENT_ARRAY_BUFFER."],"Parameters":[],"Returns":null}},{"Name":"Vertex_CopyDst_Storage","TypeName":null,"Value":"8","DocComment":{"Summary":"Combination of ,  and .\n    \n    For example can be used when needing to create a vertex buffer which is to be written into\n    via queue commands and used as a storage buffer (read/write). Common case scenario is\n    writing to buffer in compute shader and then reading from it in vertex shader.\n    \n    In D3D11 this will resolve to usage D3D11_USAGE_DEFAULT.\n    \n    In D3D11 this will resolve to bind flags D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS.\n    \n    In D3D11 this will resolve to misc flags D3D11_RESOURCE_MISC_BUFFER_STRUCTURED.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Uniform_CopyDst","TypeName":null,"Value":"9","DocComment":{"Summary":"Combination of  and .\n    \n    For example can be used when needing to create a uniform buffer which is to be written into\n    via queue commands.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"MapRead_CopyDst","TypeName":null,"Value":"10","DocComment":{"Summary":"Combination of  and .\n    \n    For example can be used when needing to copy and read data from a buffer,\n    such as copying data from a texture to a buffer and then from buffer to the CPU memory.","Remarks":[],"Parameters":[],"Returns":null}}],"Id":"61BB77DD49B6E9DF","Name":"BufferUsage","Type":"","DocComment":{"Summary":"The buffer usage.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"Ris.Framework.Buffers","Visibility":0},{"FieldSymbols":[{"Name":"UINT_16","TypeName":null,"Value":"0","DocComment":{"Summary":"Indices are 2 bytes unsigned integers.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"UINT_32","TypeName":null,"Value":"1","DocComment":{"Summary":"Indices are 4 bytes unsigned integers.","Remarks":[],"Parameters":[],"Returns":null}}],"Id":"05002E7E327A8ED6","Name":"IndexBufferType","Type":"","DocComment":{"Summary":"The type of index buffer.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"Ris.Framework.Buffers","Visibility":0},{"FieldSymbols":[{"Name":"POS3_COLOR4","TypeName":null,"Value":"0","DocComment":{"Summary":"Geometry format where:\n    First 3 floats are reserved for vertex position.Following 4 floats are reserved for vertex color.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Pos3_Color4_TextureCoords2","TypeName":null,"Value":"1","DocComment":{"Summary":"Geometry format where:\n    First 3 floats are reserved for vertex position.Following 4 floats are reserved for vertex color.Following 2 floats are reserved for vertex texture coordinates.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"Pos3_Color4_TextureCoords2_Aligned","TypeName":null,"Value":"2","DocComment":{"Summary":"Geometry format where:\n    First 3 floats are reserved for vertex position.Following 4 floats are reserved for vertex color.Following 2 floats are reserved for vertex texture coordinates.\n    When aligned, the vertex format is aligned to 4 floats.\n    Meaning:\n    First 