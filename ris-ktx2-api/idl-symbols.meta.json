{"Interfaces":[{"Inherits":[{"Id":"B73C7DBEEA6807D1","Name":"IDisposable","Type":"IdlNamedSymbol","DocComment":null,"Namespace":"System","Visibility":3}],"PropertySymbols":[{"Name":"FilePath","TypeSymbol":{"Name":"String","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"The file path to the .ktx or .ktx2 texture if it was loaded from a file.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":true},{"Name":"Width","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets the width of the texture.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false},{"Name":"Height","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets the height of the texture.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false},{"Name":"DataSize","TypeSymbol":{"Name":"UInt64","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets the data size.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false},{"Name":"NeedsTranscoding","TypeSymbol":{"Name":"Boolean","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Checks if the texture needs transcoding. \n    This is typically true for textures that are compressed using BasisU/ETC1S or UASTC formats \n    and have not yet been transcoded to a GPU-compatible format.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false},{"Name":"NumLevels","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets the number of mipmap levels.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false},{"Name":"VkFormat","TypeSymbol":{"Name":"VkFormat","Namespace":"RisKtx2","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets the Vulkan format of the texture.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":true,"IsStatic":false,"NullableAnnotation":false}],"MethodSymbols":[{"Name":"GetImageSize","DocComment":{"Summary":"Gets the size of the image data for a specific mip level.","Remarks":[],"Parameters":[{"Name":"mipLevel","Description":"The mip level."}],"Returns":"The size of the image."},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"UInt64","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"mipLevel","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"GetRowPitch","DocComment":{"Summary":"Gets the row pitch (the number of bytes between the start of one row of pixel data and the start of the next row) for a specific mip level.","Remarks":[],"Parameters":[{"Name":"mipLevel","Description":"The mip level."}],"Returns":"The size of a row pitch."},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"mipLevel","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"TranscodeBasis","DocComment":{"Summary":"Transcode the basis texture to the specified transcoding format.","Remarks":[],"Parameters":[{"Name":"transcodeFormat","Description":"The transcoding format."},{"Name":"transcodeFlags","Description":"The transcode flags."}],"Returns":null},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"Void","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"transcodeFormat","Type":{"Name":"KtxTranscodeFormat","Namespace":"RisKtx2","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false},{"Name":"transcodeFlags","Type":{"Name":"KtxTranscodeFlags","Namespace":"RisKtx2","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"GetImageOffset","DocComment":{"Summary":"Gets the offset of the image data for a specific level, layer, and face/slice of the texture.","Remarks":[],"Parameters":[{"Name":"level","Description":"The mip level of the image."},{"Name":"layer","Description":"The array layer level of the image."},{"Name":"faceSlice","Description":"The cube map face or depth slice of the image."}],"Returns":"The offset."},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"UInt64","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"level","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false},{"Name":"layer","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false},{"Name":"faceSlice","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"CompressBasis","DocComment":{"Summary":"Compresses the texture using the specified basis parameters.","Remarks":[],"Parameters":[{"Name":"basisParams","Description":"The ."}],"Returns":null},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"Void","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"basisParams","Type":{"Name":"IKtxBasisParams","Namespace":"RisKtx2","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"CompressBasis","DocComment":{"Summary":"Compresses a KTX2 texture using Basis Universal supercompression.\n    \n     The source images are encoded into Basis Universal format (typically ETC1S, depending on configuration)\n     and stored in a supercompressed form inside the KTX2 container.\n    \n     This process replaces the original uncompressed image data and updates the texture metadata (including DFD)\n     to reflect the new compressed state.\n    \n     \n     After compression, the texture cannot be directly uploaded to the GPU. It must first be transcoded\n     into a GPU-supported block-compressed format (such as ASTC, BC7, or ETC2) before use in rendering APIs.","Remarks":["Based on KTX-Software / libktx API:\n     https://github.khronos.org/KTX-Software/libktx/group__writer.html#ga405c44d6daf8ddf83dc805810bf4f989"],"Parameters":[{"Name":"quality","Description":"Compression quality value in the range 1\u2013255.\n     If 0 is provided, a default value of 128 is used by the underlying implementation.\n     Lower values produce faster compression and smaller files with lower quality.\n     Higher values produce better quality but slower compression and larger output."}],"Returns":null},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"Void","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"quality","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"CompressAstc","DocComment":{"Summary":"Encode and compress a ktx texture with uncompressed images to astc.\n    The images are either encoded to ASTC block-compressed format.\n    The encoded images replace the original images and the texture\u0027s fields including the DFD are modified to reflect the new state.\n    Such textures can be directly uploaded to a GPU via a graphics API.","Remarks":[],"Parameters":[{"Name":"quality","Description":"Compression quality, a value from 0 to 100.\n    Higher=higher quality/slower speed.\n    Lower=lower quality/faster speed."}],"Returns":null},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"Void","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"quality","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":null,"NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"GetTextureData","DocComment":{"Summary":"Gets the raw texture data from the native KTX texture object.","Remarks":[],"Parameters":[],"Returns":"The texture data as an int ptr."},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"IntPtr","Namespace":"System","IsArray":false,"ElementType":null},"Parameters":[{"Name":"offset","Type":{"Name":"UInt64","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false}],"IsStatic":false},{"Name":"GetTextureDataAsByteArray","DocComment":{"Summary":"Gets the texture data from the native KTX texture object.","Remarks":[],"Parameters":[{"Name":"level","Description":"The mipmap level."},{"Name":"layer","Description":"The array layer."},{"Name":"faceSlice","Description":"The face or slice index."}],"Returns":"The texture data as a byte array."},"Visibility":0,"NullableAnnotation":false,"ReturnType":{"Name":"Array","Namespace":"","IsArray":true,"ElementType":{"Name":"Byte","Namespace":"System","IsArray":false,"ElementType":null}},"Parameters":[{"Name":"level","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false},{"Name":"layer","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false},{"Name":"faceSlice","Type":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DefaultValue":"0","NullableAnnotation":false,"IsStatic":false}],"IsStatic":false}],"EventSymbols":[],"Id":"0F945E7509199177","Name":"IKtx2Texture","Type":"IdlInterfaceSymbol","DocComment":{"Summary":"The KtxTexture class represents a texture loaded from a KTX file. \n    It provides methods for loading, transcoding, and retrieving texture data.\n    The class manages the lifecycle of the native KTX texture object, ensuring that resources are properly released when the texture is no longer needed. \n    It also includes error handling to provide informative exceptions when operations fail, such as loading or transcoding errors.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"RisKtx2","Visibility":0},{"Inherits":[],"PropertySymbols":[{"Name":"CompressionLevel","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Encoding speed vs. quality tradeoff.\n    Range is [0,5].\n    Higher values are slower but give higher quality.\n    There is no default.\n    Callers must explicitly set this value.\n    Currently, this is 2.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"QualityLevel","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Gets or sets the quality level for compression.","Remarks":["QualityLevel must be in the range [1, 255].\n    Lower values give better compression and faster processing but lower quality,\n    while higher values give less compression, higher quality, and slower processing.\n    This parameter automatically determines values for maxEndpoints, maxSelectors, endpointRDOThreshold,\n    and selectorRDOThreshold for the target quality level. \n    Setting these parameters overrides the values determined by QualityLevel,\n    which defaults to 128 if neither it nor both of maxEndpoints and maxSelectors have been set.","This controls the visual quality target of ETC1S encoding."],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"Uastc","TypeSymbol":{"Name":"Boolean","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Specifies whether to use UASTC encoding.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"UastcFlags","TypeSymbol":{"Name":"KtxUastcFlags","Namespace":"RisKtx2","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Specifies UASTC encoding options.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"NormalMap","TypeSymbol":{"Name":"Boolean","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Tunes codec parameters for better quality on normal maps (no selector RDO, no endpoint RDO) and sets the texture\u0027s DFD appropriately.\n    Only valid for linear textures.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"ThreadCount","TypeSymbol":{"Name":"UInt32","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Number of threads used for compression. Default is 1.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"InputSwizzle","TypeSymbol":{"Name":"Array","Namespace":"","IsArray":true,"ElementType":{"Name":"Char","Namespace":"System","IsArray":false,"ElementType":null}},"DocComment":{"Summary":"A swizzle to apply before encoding.\n    It must match the regular expression /^[rgba01]{4}$/.\n    If both this and preSwizzle are specified, ktxTexture_CompressBasisEx will raise KTX_INVALID_OPERATION.\n    Usable with both ETC1S and UASTC.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"UastcRDO","TypeSymbol":{"Name":"Boolean","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"Enable Rate Distortion Optimization (RDO) post-processing.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"UastcRDOQualityScalar","TypeSymbol":{"Name":"Single","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"UASTC RDO quality scalar (lambda).\n    Lower values yield higher quality/larger LZ compressed files, higher values yield lower quality/smaller LZ compressed files. \n    A good range to try is [.2,4].\n    The full range is [.001,50.0].\n    Default is 1.0.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false},{"Name":"Verbose","TypeSymbol":{"Name":"Boolean","Namespace":"System","IsArray":false,"ElementType":null},"DocComment":{"Summary":"If true\u003E, prints Basis Universal encoder operation details to output stream.\n    Not recommended for GUI apps.","Remarks":[],"Parameters":[],"Returns":null},"Visibility":0,"IsReadonly":false,"IsStatic":false,"NullableAnnotation":false}],"MethodSymbols":[],"EventSymbols":[],"Id":"E67D182D06920199","Name":"IKtxBasisParams","Type":"IdlInterfaceSymbol","DocComment":{"Summary":"The parameters for the Basis Universal compression algorithm.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"RisKtx2","Visibility":0}],"Classes":[],"Enums":[{"FieldSymbols":[{"Name":"NONE","TypeName":null,"Value":"0","DocComment":{"Summary":"No special transcoding options.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TF_PVRTC_DECODE_TO_NEXT_POW2","TypeName":null,"Value":"2","DocComment":null},{"Name":"KTX_TF_TRANSCODE_ALPHA_DATA_TO_OPAQUE_FORMATS","TypeName":null,"Value":"4","DocComment":null},{"Name":"KTX_TF_HIGH_QUALITY","TypeName":null,"Value":"32","DocComment":null}],"Id":"F4AABFCC8240D795","Name":"KtxTranscodeFlags","Type":"","DocComment":{"Summary":"The KtxTranscodeFlags enumeration defines flags that can be used to control the transcoding process when converting BasisU/ETC1S or UASTC compressed textures to other formats. These flags can specify options such as how to handle non-power-of-two textures, whether to transcode alpha data for opaque formats, and whether to request higher quality transcoding for certain formats.","Remarks":[],"Parameters":[],"Returns":null},"Namespace":"RisKtx2","Visibility":0},{"FieldSymbols":[{"Name":"KTX_TTF_ETC1_RGB","TypeName":null,"Value":"0","DocComment":null},{"Name":"ETC2_RGBA","TypeName":null,"Value":"1","DocComment":{"Summary":"Transcode to ETC2 compressed RGBA texture.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TTF_BC1_RGB","TypeName":null,"Value":"2","DocComment":null},{"Name":"BC3_RGBA","TypeName":null,"Value":"3","DocComment":{"Summary":"Transcode to BC3 compressed RGBA texture.\n    Common on desktop devices.\n    Oldest and most widely supported block compression format for color textures.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TTF_BC4_R","TypeName":null,"Value":"4","DocComment":null},{"Name":"KTX_TTF_BC5_RG","TypeName":null,"Value":"5","DocComment":null},{"Name":"BC7_RGBA","TypeName":null,"Value":"6","DocComment":{"Summary":"BC7 compressed RGBA texture.\n    High quality block compression for color textures.\n    Supports alpha channel and is suitable for diffuse/physically based textures.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TTF_PVRTC1_4_RGB","TypeName":null,"Value":"8","DocComment":null},{"Name":"KTX_TTF_PVRTC1_4_RGBA","TypeName":null,"Value":"9","DocComment":null},{"Name":"ASTC_4X4_RGBA","TypeName":null,"Value":"10","DocComment":{"Summary":"Compressed ASTC 4x4 RGBA texture.\n    Common on mobile devices, especially Apple. High quality block compression for color textures.\n    Supports alpha channel and is suitable for diffuse/physically based textures.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TTF_PVRTC2_4_RGB","TypeName":null,"Value":"18","DocComment":null},{"Name":"KTX_TTF_PVRTC2_4_RGBA","TypeName":null,"Value":"19","DocComment":null},{"Name":"KTX_TTF_ETC2_EAC_R11","TypeName":null,"Value":"20","DocComment":null},{"Name":"KTX_TTF_ETC2_EAC_RG11","TypeName":null,"Value":"21","DocComment":null},{"Name":"RGBA32","TypeName":null,"Value":"13","DocComment":{"Summary":"Uncompressed RGBA 32bpp image format.\n    Not a block compressed format.\n    Supported on all devices.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"KTX_TTF_RGB565","TypeName":null,"Value":"14","DocComment":null},{"Name":"KTX_TTF_BGR565","TypeName":null,"Value":"15","DocComment":null},{"Name":"KTX_TTF_RGBA4444","TypeName":null,"Value":"16","DocComment":null},{"Name":"KTX_TTF_ETC","TypeName":null,"Value":"22","DocComment":null},{"Name":"KTX_TTF_BC1_OR_3","TypeName":null,"Value":"23","DocComment":null},{"Name":"KTX_TTF_NOSELECTION","TypeName":null,"Value":"2147483647","DocComment":null}],"Id":"C66F0823CF8B4D28","Name":"KtxTranscodeFormat","Type":"","DocComment":null,"Namespace":"RisKtx2","Visibility":0},{"FieldSymbols":[{"Name":"LEVEL_FASTEST","TypeName":null,"Value":"0","DocComment":{"Summary":"Fastest compression (the lowest quality, the highest speed). ~43.45 dB.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"LEVEL_FASTER","TypeName":null,"Value":"1","DocComment":{"Summary":"Faster compression. ~46.49 dB.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"LEVEL_DEFAULT","TypeName":null,"Value":"2","DocComment":{"Summary":"Default compression level (balanced). ~47.47 dB.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"LEVEL_SLOWER","TypeName":null,"Value":"3","DocComment":{"Summary":"Slower compression (higher quality). ~48.01 dB.","Remarks":[],"Parameters":[],"Returns":null}},{"Name":"LEVEL_VERY_SLOW","TypeName":null,"Value":"4","DocComment":{"Summary":"Very slow